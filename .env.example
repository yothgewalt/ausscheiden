# Postgres — source of truth for booked tables. Matches docker-compose.yml.
DATABASE_URL="postgres://ausscheiden:ausscheiden@localhost:5432/ausscheiden"

# Redis — ephemeral table locks (TTL) + pub/sub broadcast.
REDIS_URL="redis://localhost:6379"

# Port the custom server (server.ts) listens on.
PORT=3000

# WebSocket endpoint the browser dials for tRPC subscriptions.
# In dev this is the same host/port as the app, path /api/trpc.
NEXT_PUBLIC_WS_URL="ws://localhost:3000/api/trpc"

# RDCW Slip Verify API — server-only secrets from the RDCW dashboard. https://slip.rdcw.co.th/docs
RDCW_CLIENT_ID=""
RDCW_CLIENT_SECRET=""
