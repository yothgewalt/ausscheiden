# Postgres — source of truth for booked tables. Matches docker-compose.yml (dev).
DATABASE_URL="postgres://ausscheiden:ausscheiden@localhost:5432/ausscheiden"

# Redis — ephemeral table locks (TTL) + pub/sub broadcast.
REDIS_URL="redis://localhost:6379"

# HMAC key that signs the session cookie (fixation resistance). PROD: required —
# the app throws at startup if unset. Use a long random value, e.g.
# `openssl rand -base64 32`. Dev falls back to a constant, so this is optional locally.
SESSION_SECRET="dev-insecure-session-secret"

# PROD ONLY (docker-compose.prod.yml). Compose refuses to start if these are
# unset — no weak default. Set strong values; the app URLs above are rebuilt from
# them inside the prod stack (DATABASE_URL gets POSTGRES_PASSWORD, REDIS_URL gets
# REDIS_PASSWORD as redis://:PASSWORD@redis:6379). Not needed for local dev.
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""

# Port the custom server (server.ts) listens on.
PORT=3000

# WebSocket endpoint the browser dials for tRPC subscriptions.
# In dev this is the same host/port as the app, path /api/trpc.
NEXT_PUBLIC_WS_URL="ws://localhost:3000/api/trpc"

# RDCW Slip Verify API — server-only secrets from the RDCW dashboard. https://slip.rdcw.co.th/docs
RDCW_CLIENT_ID=""
RDCW_CLIENT_SECRET=""

# MinIO / S3 slip archive. Matches docker-compose.yml (dev). Key layout:
# <tableId|'individual'>/<ref>/slip.<ext>.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="slips"
S3_ACCESS_KEY_ID="ausscheiden"
S3_SECRET_ACCESS_KEY="ausscheiden"

# PROD ONLY (docker-compose.prod.yml). Compose refuses to start if unset. These
# ARE the MinIO root creds AND the app's S3 keys (S3_ACCESS_KEY_ID/SECRET are
# rebuilt from them inside the prod stack).
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""

# PROD port exposure. Postgres (5432) and MinIO (9000 API / 9001 console) publish
# to 127.0.0.1 by default — reach them via `ssh -L`. Set to 0.0.0.0 to open to the
# network (only behind a firewall/VPN; both hold credentials).
DB_BIND="127.0.0.1"
MINIO_BIND="127.0.0.1"
